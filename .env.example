# LIVE_EARLY_EXIT_TIMESTOP_MAX_ROI_PCT=-8
# LIVE_PRE_EXPIRY_LIQUIDATION_ENABLED=false
# LIVE_PRE_EXPIRY_LIQUIDATION_REMAIN_SEC=12
