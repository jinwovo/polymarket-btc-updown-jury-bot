# Polymarket auth (recommended)
# If POLYMARKET_PRIVATE_KEY is set, runtime auto-derives API creds and writes
# .env.polymarket.generated (git-ignored by .env.* rule).
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here
POLYMARKET_FUNDER=your_wallet_or_proxy_address_here
# POLYMARKET_SIGNATURE_TYPE=-1   # -1:auto, 0:EOA, 1:POLY_PROXY, 2:POLY_GNOSIS_SAFE

# Optional manual API creds (usually not needed when private key mode is used)
# POLYMARKET_API_KEY=your_api_key_here
# POLYMARKET_API_SECRET=your_api_secret_here
# POLYMARKET_API_PASSPHRASE=your_passphrase_here

# Optional: override defaults
# DRY_RUN=true
# MAX_BET_SIZE=5.0
# LIVE_SIZING_MODE=ADAPTIVE  # ADAPTIVE | FIXED
# LIVE_ADAPTIVE_BASE_FRAC=0.075
# LIVE_ADAPTIVE_MIN_FRAC=0.040
# LIVE_ADAPTIVE_MAX_FRAC=0.150
# LIVE_ADAPTIVE_EDGE_BOOST=0.25
# LIVE_ADAPTIVE_CONF_BOOST=0.12
# POSITION_MODE=BOTH   # BOTH | UP_ONLY | DOWN_ONLY
# DAILY_LOSS_LIMIT=50.0
# MIN_EDGE=0.08
# JURY_THRESHOLD=3
# TRADE_FEE_RATE=0.010
# MIN_EXPECTED_ROI=0.003
# ENTRY_DECISION_MODE=PROBABILITY_FIRST  # PROBABILITY_FIRST | EV_FIRST | HYBRID
# MIN_WIN_PROBABILITY=0.53
# WIN_PROB_MARGIN=0.005
# CLOSE_PROB_MIN_ALIGNED_MOVE_PCT=0.015
# CLOSE_PROB_ALIGNMENT_PENALTY_MAX=0.10
# CLOSE_PROB_BOUNDARY_SIGMA_MULT=0.45
# CLOSE_PROB_UNCERTAINTY_PENALTY_MAX=0.08
# UP_REGIME_FILTER_ENABLED=true
# UP_REGIME_MIN_SCORE=0.56
# UP_REGIME_MOVE_SCALE_PCT=0.060
# UP_REGIME_MOM10_SCALE_PCT=0.030
# UP_REGIME_MOM30_SCALE_PCT=0.050
# UP_REGIME_MOM60_SCALE_PCT=0.080
# UP_REGIME_WHIPSAW_PCT=0.020
# UP_REGIME_MAX_JUMP_RATIO=0.45
# UP_REGIME_MIN_MOM30_PCT=-0.010
# UP_REGIME_MIN_MOVE_FROM_START_PCT=0.005
# ENTRY_ORDER_MODE=LIMIT_GTC      # LIMIT_GTC | LIMIT_FAK | MARKET
# LIMIT_ORDER_TIMEOUT_SECONDS=2.5
# ORDER_POLL_INTERVAL_SECONDS=0.35
# MAX_ENTRY_PRICE_DRIFT_ABS=0.010
# MAX_ENTRY_PRICE_DRIFT_RATIO=0.03
# LIVE_ENTRY_START_SECONDS=75
# LIVE_MIN_SUPPORT_RATIO=0.70
# LIVE_REQUIRE_UNANIMOUS=false
# LIVE_RECENT_MOVE_LOOKBACK_SEC=20
# LIVE_MIN_RECENT_MOVE_PCT=0.006
# LIVE_MAX_OPPOSITE_IMPLIED=0.62
# LIVE_MIN_ENTRY_SIDE_IMPLIED=0.22
# LIVE_DOWN_ABOVE_START_BLOCK_PCT=0.015
# LIVE_DOWN_ABOVE_START_MOMENTUM_EXTRA=0.006
# LIVE_DOWN_ABOVE_START_EV_PENALTY=0.020
# FEATURE_LOOKBACK_SECONDS=600
# FEATURE_RESAMPLE_SECONDS=1.0
# FEATURE_MAX_POINTS=900

# Fast-lane (judge bypass for Binance lead / Polymarket lag)
# FAST_LANE_ENABLED=true
# FAST_LANE_MIN_SECONDS_ELAPSED=20
# FAST_LANE_MAX_SECONDS_ELAPSED=160
# FAST_LANE_MIN_SECONDS_REMAINING=95
# FAST_LANE_MIN_MOVE_PCT=0.040
# FAST_LANE_MAX_MOVE_PCT=0.300
# FAST_LANE_RECENT_LOOKBACK_SEC=10
# FAST_LANE_MIN_RECENT_MOVE_PCT=0.015
# FAST_LANE_VOL_LOOKBACK_SEC=150
# FAST_LANE_DRIFT_WEIGHT=0.30
# FAST_LANE_MAX_ENTRY_PRICE=0.46
# FAST_LANE_MIN_DIRECTION_PROB=0.57
# FAST_LANE_MIN_PROB_EDGE=0.050
# FAST_LANE_MIN_EXPECTED_ROI=0.080

# Paper sim advanced guards
# PAPER_MAX_OPPOSITE_IMPLIED=0.62
# PAPER_MIN_ENTRY_SIDE_IMPLIED=0.22
# PAPER_DOWN_ABOVE_START_BLOCK_PCT=0.015
# PAPER_DOWN_ABOVE_START_MOMENTUM_EXTRA=0.006
# PAPER_DOWN_ABOVE_START_EV_PENALTY=0.020
# PAPER_ENABLE_EARLY_EXIT=true
# PAPER_EARLY_EXIT_MIN_ELAPSED_SEC=25
# PAPER_EARLY_EXIT_OPPOSITE_ASK=0.70
# PAPER_EARLY_EXIT_STOP_LOSS_ROI_PCT=-45
# PAPER_EARLY_EXIT_STOP_LOSS_MIN_HOLD_SEC=35
# PAPER_EARLY_EXIT_STOP_LOSS_HIGH_CONF_CUTOFF=0.75
# PAPER_EARLY_EXIT_STOP_LOSS_HIGH_CONF_MIN_HOLD_SEC=20
# PAPER_EARLY_EXIT_STOP_LOSS_LOW_CONF_CUTOFF=0.60
# PAPER_EARLY_EXIT_STOP_LOSS_LOW_CONF_RELAX_PCT=15
# PAPER_EARLY_EXIT_MAX_HOLD_SEC=95
# PAPER_EARLY_EXIT_TIMESTOP_MAX_ROI_PCT=5

# Database backend (default: sqlite)
# DB_BACKEND=sqlite
# SQLITE_DB_PATH=market_data.db

# MariaDB settings (used when DB_BACKEND=mariadb)
# MARIADB_HOST=127.0.0.1
# MARIADB_PORT=3306
# MARIADB_USER=root
# MARIADB_PASSWORD=your_password
# MARIADB_DATABASE=future_prediction
