# Polymarket CLOB API
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here
POLYMARKET_FUNDER=your_wallet_address_here

# Optional: override defaults
# DRY_RUN=true
# MAX_BET_SIZE=5.0
# POSITION_MODE=BOTH   # BOTH | UP_ONLY | DOWN_ONLY
# DAILY_LOSS_LIMIT=50.0
# MIN_EDGE=0.08
# JURY_THRESHOLD=3
# TRADE_FEE_RATE=0.010
# MIN_EXPECTED_ROI=0.003
# ENTRY_ORDER_MODE=LIMIT_GTC      # LIMIT_GTC | LIMIT_FAK | MARKET
# LIMIT_ORDER_TIMEOUT_SECONDS=2.5
# ORDER_POLL_INTERVAL_SECONDS=0.35
# MAX_ENTRY_PRICE_DRIFT_ABS=0.010
# MAX_ENTRY_PRICE_DRIFT_RATIO=0.03
# LIVE_ENTRY_START_SECONDS=75
# LIVE_MIN_SUPPORT_RATIO=0.70
# LIVE_REQUIRE_UNANIMOUS=false
# LIVE_RECENT_MOVE_LOOKBACK_SEC=20
# LIVE_MIN_RECENT_MOVE_PCT=0.006
# LIVE_MAX_OPPOSITE_IMPLIED=0.56
# LIVE_MIN_ENTRY_SIDE_IMPLIED=0.22
# LIVE_DOWN_ABOVE_START_BLOCK_PCT=0.015
# LIVE_DOWN_ABOVE_START_MOMENTUM_EXTRA=0.006
# LIVE_DOWN_ABOVE_START_EV_PENALTY=0.020

# Paper sim advanced guards
# PAPER_MAX_OPPOSITE_IMPLIED=0.56
# PAPER_MIN_ENTRY_SIDE_IMPLIED=0.22
# PAPER_DOWN_ABOVE_START_BLOCK_PCT=0.015
# PAPER_DOWN_ABOVE_START_MOMENTUM_EXTRA=0.006
# PAPER_DOWN_ABOVE_START_EV_PENALTY=0.020
# PAPER_ENABLE_EARLY_EXIT=true
# PAPER_EARLY_EXIT_MIN_ELAPSED_SEC=25
# PAPER_EARLY_EXIT_OPPOSITE_ASK=0.70
# PAPER_EARLY_EXIT_STOP_LOSS_ROI_PCT=-45
# PAPER_EARLY_EXIT_MAX_HOLD_SEC=95
# PAPER_EARLY_EXIT_TIMESTOP_MAX_ROI_PCT=5

# Database backend (default: sqlite)
# DB_BACKEND=sqlite
# SQLITE_DB_PATH=market_data.db

# MariaDB settings (used when DB_BACKEND=mariadb)
# MARIADB_HOST=127.0.0.1
# MARIADB_PORT=3306
# MARIADB_USER=root
# MARIADB_PASSWORD=your_password
# MARIADB_DATABASE=future_prediction
