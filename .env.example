# Polymarket auth (recommended)
# If POLYMARKET_PRIVATE_KEY is set, runtime auto-derives API creds and writes
# .env.polymarket.generated (git-ignored by .env.* rule).
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here
POLYMARKET_FUNDER=your_wallet_or_proxy_address_here
# POLYMARKET_SIGNATURE_TYPE=-1   # -1:auto, 0:EOA, 1:POLY_PROXY, 2:POLY_GNOSIS_SAFE
# POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
# POLYMARKET_RELAYER_CHAIN_ID=137

# Optional manual CLOB API creds (advanced)
# Usually leave empty and use private-key auto-derive.
# POLYMARKET_API_KEY=your_api_key_here
# POLYMARKET_API_SECRET=your_api_secret_here
# POLYMARKET_API_PASSPHRASE=your_passphrase_here

# Optional Builder creds (Relayer/Redeem only, separate from trading auth)
# POLY_BUILDER_API_KEY=your_builder_api_key_here
# POLY_BUILDER_API_SECRET=your_builder_api_secret_here
# POLY_BUILDER_API_PASSPHRASE=your_builder_passphrase_here

# Optional: override defaults
# DRY_RUN=true
# MAX_BET_SIZE=5.0
# LIVE_SIZING_MODE=ADAPTIVE  # ADAPTIVE | FIXED
# LIVE_PROFIT_MODE=AGGRESSIVE   # AGGRESSIVE | BALANCED
# LIVE_AGGRESSIVE_ENTRY_RELAX=0.20
# LIVE_AGGRESSIVE_MIN_EDGE_RELAX=0.20
# LIVE_AGGRESSIVE_SUPPORT_RELAX=0.10
# LIVE_AGGRESSIVE_MAX_FRAC=0.12
# LIVE_AGGRESSIVE_KELLY_FRAC=0.50
# LIVE_AGGRESSIVE_LOSS_DEBOOST=0.82
# LIVE_ADAPTIVE_BASE_FRAC=0.075
# LIVE_ADAPTIVE_MIN_FRAC=0.040
# LIVE_ADAPTIVE_MAX_FRAC=0.150
# LIVE_ADAPTIVE_EDGE_BOOST=0.25
# LIVE_ADAPTIVE_CONF_BOOST=0.12
# POSITION_MODE=BOTH   # BOTH | UP_ONLY | DOWN_ONLY
# DAILY_LOSS_LIMIT=50.0
# MIN_EDGE=0.08
# JURY_THRESHOLD=3
# TRADE_FEE_RATE=0.010
# MIN_EXPECTED_ROI=0.003
# ENTRY_DECISION_MODE=PROBABILITY_FIRST  # PROBABILITY_FIRST | EV_FIRST | HYBRID
# MIN_WIN_PROBABILITY=0.53
# WIN_PROB_MARGIN=0.005
# CLOSE_PROB_MIN_ALIGNED_MOVE_PCT=0.015
# CLOSE_PROB_ALIGNMENT_PENALTY_MAX=0.10
# CLOSE_PROB_BOUNDARY_SIGMA_MULT=0.45
# CLOSE_PROB_UNCERTAINTY_PENALTY_MAX=0.08
# UP_REGIME_FILTER_ENABLED=true
# UP_REGIME_MIN_SCORE=0.56
# UP_REGIME_MOVE_SCALE_PCT=0.060
# UP_REGIME_MOM10_SCALE_PCT=0.030
# UP_REGIME_MOM30_SCALE_PCT=0.050
# UP_REGIME_MOM60_SCALE_PCT=0.080
# UP_REGIME_WHIPSAW_PCT=0.020
# UP_REGIME_MAX_JUMP_RATIO=0.45
# UP_REGIME_MIN_MOM30_PCT=-0.010
# UP_REGIME_MIN_MOVE_FROM_START_PCT=0.005
# ENTRY_ORDER_MODE=LIMIT_GTC      # LIMIT_GTC | LIMIT_FAK | MARKET
# LIMIT_ORDER_TIMEOUT_SECONDS=2.5
# ORDER_POLL_INTERVAL_SECONDS=0.35
# MAX_ENTRY_PRICE_DRIFT_ABS=0.010
# MAX_ENTRY_PRICE_DRIFT_RATIO=0.03
# LIVE_ENTRY_START_SECONDS=75
# LIVE_MIN_SUPPORT_RATIO=0.70
# LIVE_REQUIRE_UNANIMOUS=false
# LIVE_BALANCE_REFRESH_SECONDS=30
# LIVE_MAINTENANCE_GUARD_ENABLED=true
# LIVE_MAINTENANCE_FAIL_THRESHOLD=6
# LIVE_MAINTENANCE_PROBE_INTERVAL_SECONDS=300
# LIVE_MAINTENANCE_RECOVER_SUCCESS_COUNT=1
# LIVE_TELEGRAM_ENABLED=false
# LIVE_TELEGRAM_BOT_TOKEN=
# LIVE_TELEGRAM_CHAT_ID=
# LIVE_TELEGRAM_NOTIFY_OPEN=true
# LIVE_TELEGRAM_NOTIFY_CLOSE=true
# LIVE_AUTO_CLAIM_ENABLED=true
# LIVE_AUTO_CLAIM_INTERVAL_SECONDS=90
# LIVE_SETTLEMENT_EXIT_ENABLED=true
# LIVE_SETTLEMENT_EXIT_DELAY1_SEC=10
# LIVE_SETTLEMENT_EXIT_DELAY2_SEC=20
