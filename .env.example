# LIVE_RECENT_MOVE_LOOKBACK_SEC=20
# LIVE_MIN_RECENT_MOVE_PCT=0.006
# LIVE_TREND_ALIGN_LOOKBACK_SEC=75
# LIVE_TREND_ALIGN_MAX_OPPOSING_MOVE_PCT=0.004
# LIVE_MAX_OPPOSITE_IMPLIED=0.62
# LIVE_MIN_ENTRY_SIDE_IMPLIED=0.22
# LIVE_MAX_CONTRA_GAP=0.030
