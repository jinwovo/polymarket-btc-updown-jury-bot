# FEATURE_LOOKBACK_SECONDS=600
# FEATURE_RESAMPLE_SECONDS=1.0
# FEATURE_MAX_POINTS=900

# Fast-lane (judge bypass for Binance lead / Polymarket lag)
# FAST_LANE_ENABLED=true
# FAST_LANE_MIN_SECONDS_ELAPSED=20
# FAST_LANE_MAX_SECONDS_ELAPSED=160
# FAST_LANE_MIN_SECONDS_REMAINING=95
# FAST_LANE_MIN_MOVE_PCT=0.040
# FAST_LANE_MAX_MOVE_PCT=0.300
# FAST_LANE_RECENT_LOOKBACK_SEC=10
# FAST_LANE_MIN_RECENT_MOVE_PCT=0.015
# FAST_LANE_VOL_LOOKBACK_SEC=150
# FAST_LANE_DRIFT_WEIGHT=0.30
# FAST_LANE_MAX_ENTRY_PRICE=0.46
# FAST_LANE_MIN_DIRECTION_PROB=0.57
# FAST_LANE_MIN_PROB_EDGE=0.050
# FAST_LANE_MIN_EXPECTED_ROI=0.080

# Paper sim advanced guards
# PAPER_MAX_OPPOSITE_IMPLIED=0.62
# PAPER_MIN_ENTRY_SIDE_IMPLIED=0.22
# PAPER_DOWN_ABOVE_START_BLOCK_PCT=0.015
# PAPER_DOWN_ABOVE_START_MOMENTUM_EXTRA=0.006
# PAPER_DOWN_ABOVE_START_EV_PENALTY=0.020
# PAPER_PROFIT_MODE=aggressive      # aggressive | balanced
# PAPER_AGGRESSIVE_ENTRY_RELAX=0.20
# PAPER_AGGRESSIVE_GAP_MULT=0.65
# PAPER_AGGRESSIVE_MAX_BET_FRAC=0.12
# PAPER_AGGRESSIVE_KELLY_FRAC=0.50
# PAPER_AGGRESSIVE_LOSS_DEBOOST=0.82
