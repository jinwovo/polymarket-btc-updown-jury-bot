# Copy this file to `.env.secrets` and fill your real secrets.
# `.env.secrets` is ignored by git.

# Database backend
DB_BACKEND=mariadb
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=your_mariadb_password_here
MARIADB_DATABASE=polymarket_btc_updown

# Polymarket auth (recommended: private key + derive)
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here
POLYMARKET_FUNDER=your_wallet_or_proxy_address_here
POLYMARKET_SIGNATURE_TYPE=-1

# Optional manual CLOB API creds (advanced)
# POLYMARKET_API_KEY=your_api_key_here
# POLYMARKET_API_SECRET=your_api_secret_here
# POLYMARKET_API_PASSPHRASE=your_passphrase_here

# Optional Builder creds (Relayer/Redeem only)
# POLY_BUILDER_API_KEY=your_builder_api_key_here
# POLY_BUILDER_API_SECRET=your_builder_api_secret_here
# POLY_BUILDER_API_PASSPHRASE=your_builder_passphrase_here

# Optional Telegram live notifications
LIVE_TELEGRAM_ENABLED=false
# LIVE_TELEGRAM_BOT_TOKEN=your_bot_token_here
# LIVE_TELEGRAM_CHAT_ID=your_chat_id_here
