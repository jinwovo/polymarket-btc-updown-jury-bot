# Public runtime knobs (safe to commit)
# Keep secrets in .env.secrets (ignored by git).

# Optional runtime knobs
# DRY_RUN is NOT set here — dashboard controls it via env_overrides:
#   Start Live → DRY_RUN=false, Start (dry) → DRY_RUN=true (default).
# Setting it here with override=True would overwrite dashboard's value.
# Fixed sizing: adaptive compounds losses, fixed bet recovers.
# Backtest showed fixed $100 = all periods profitable, adaptive = loses.
MAX_BET_SIZE=500.0
# LIVE_FIXED_STAKE: per-trade stake for BTC5 live (main.py).
# WITHOUT this, main.py defaults to MAX_BET_SIZE = $500 (CATASTROPHIC).
# Set to match PAPER_FIXED_STAKE for paper=live parity.
LIVE_FIXED_STAKE=10.0
# Paper: fixed $100 for testing
PAPER_SIZING_MODE=FIXED
PAPER_FIXED_STAKE=10.0
# DIRECT-TRIGGER mode (2026-04-29): bypass judges, use price-based direction.
# BTC5 paper_replay 480h: 155t/0/40 neg/58% WR/+$381 ($10 stake). ALL periods positive.
# When ON: ignores judge gate_allow, uses btc_move sign for direction,
#          applies Wide BB (0.3-1.5/-1.5--0.3) + path_r2 >= 0.15 filter.
PAPER_DIRECT_TRIGGER=true
# 2026-07-04 OOS validation (Apr/May/Jun signal_cache replay): r2 0.05 -> 0.10.
# +DRIFT08+R2_10+S100 combo: Apr $+244/PF1.51, May $+201/PF2.06, Jun $+119/PF2.32
# (baseline was Apr $+180/PF1.29, May $+140/PF1.58, Jun $+96/PF1.74). Better in ALL months.
PAPER_DIRECT_R2_MIN=0.10
# 2026-06-06 v2: bb_min 0.7 -> 0.9. 96h sweep:
# bb=0.9+r2=0.05+start=80 = 31t/80.6% WR/+$214/$54/day. Tighter BB filters noisy signals.
PAPER_DIRECT_BB_MAX=2.5
PAPER_DIRECT_BB_MIN_ABS=0.9
# Min confidence (JUDGE MODE only - bypass in direct mode)
PAPER_MIN_CONFIDENCE=0.65
# conf>=0.55 filter: skip when jury confidence < 0.55. No mega (flat bet).
# 480h: 250t(0.5/h) 57% WR +$427. All periods positive.
# Score filter disabled (0) — conf alone is sufficient and gives more trades.
# Kelly sizing: tested 2026-04-04, paper_replay showed WORSE results (-59%)
# Score distribution with gate_allow filter doesn't benefit from Kelly.
PAPER_KELLY_SIZING=false
LIVE_KELLY_SIZING=false
PAPER_MEGA_MULTIPLIER=1.0
PAPER_MIN_ENTRY_SCORE=0
PAPER_MEGA_MIN_SCORE=99
LIVE_MEGA_MULTIPLIER=1.0
LIVE_MIN_ENTRY_SCORE=0
LIVE_MEGA_MIN_SCORE=99
# Live: FIXED mode = seed capital * LIVE_FIXED_SEED_PCT
# $100 seed * 15% = $15/trade, always. Win or lose, same amount.
LIVE_SIZING_MODE=FIXED
LIVE_FIXED_SEED_PCT=0.15
# Sweep result: late-entry (START=150s) = 75.3% WR, PF=3.35
MIN_EDGE=0.12
# Sweep result: J=2 (majority) unlocks 107+ trades vs 4 with J=3 (unanimous).
# 3 judges rarely all agree; requiring 2/3 gives 63.6% WR, PF=1.90.
JURY_THRESHOLD=2
# Raised from 0.020→0.050: need stronger EV to overcome marginal signals
# Raised 0.050->0.150: sweep showed ev>=0.15 gives 61-71% WR across all periods
MIN_EXPECTED_ROI=0.150
# Spread filter: tighter spread = higher WR but fewer trades.
# 0.20 = best PnL (+$2,294). 0.10 = higher WR but -$266 PnL.
PAPER_MAX_ODDS_SPREAD=0.20
# Min overround (up_ask + down_ask - 1.0): skip tight book where live fills are worse
# Live data: overround>=0.02 = 69% WR vs <0.02 = 50% WR (153 trades, ep<=0.52 regime)
# BUT combined with ask=0.44, too few trades (33/240h). Disabled for now.
PAPER_MIN_OVERROUND=0
# Trend-aware sizing: DISABLED 2026-04-20 — 2.5x AGAINST amplifies losses in current regime.
# $500 losses traced to this multiplier (trend_against * qs_direct stacking).
# Recent: $250+ stakes WR=0%. Revert to flat until regime stabilizes.
PAPER_TREND_SIZING=false
PAPER_TREND_LOOKBACK=3
PAPER_TREND_WITH_MULT=1.0
PAPER_TREND_AGAINST_MULT=1.0
# QS-inverse sizing: DISABLED 2026-04-20 — regime shift broke this.
# Recent 72h live paper: $250+ stakes WR=0%, $200-250 WR=60%, $100-150 WR=85.7%.
# Big stakes are LOSING. Backtest regime != current regime. Revert to flat.
PAPER_QS_INVERSE_SIZING=false
PAPER_QS_INVERSE_FACTOR=1.0
# R2-direct sizing: DISABLED 2026-04-20 — same reason as QS-inverse above.
# When signal is "strong" in current market, it's often fake trend that reverses.
# ETH5 72h: stake>=$200 -> 11t/18%WR/-$1,361. Large bets are TOXIC.
PAPER_R2_SIZING=false
# Sizing cap: tightened to 1.5x (from 3.0x) as safety rail
PAPER_SIZING_CAP_FLOOR=0.5
PAPER_SIZING_CAP_CEILING=1.5
# R2 entry filter: KEEP — this filter skips bad trades (doesn't boost bet size).
# Analysis: 240h 188t/46%/$4660 -> 131t/50%/$5199 (+$539) with r2>=0.10
# Recent 72h: WR 41% -> 49% (+$458 PnL). Kills bad trades in noisy markets.
PAPER_R2_MIN_FILTER=0.10
PAPER_R2_BYPASS_LATE=true
# BB bad-zone filter (2026-04-20 live paper analysis): skip 3 zones that kill PnL.
# BTC5 240h: -$229 -> +$1,482 (+$1,711) by excluding 33t / 30% WR / -$1,711.
# Zones: UP+bb[0.5,1.0) (fake momentum), DOWN+bb>=0.5 (fighting trend),
#        DOWN+bb<=-1.5 (extreme oversold reversal).
PAPER_BB_BAD_ZONE_FILTER=true
# ETH5 DIRECT-TRIGGER mode (2026-04-20): bypass judges for higher WR.
# When true:
#   - Ignores judge gate_allow / direction
#   - Direction derived from ETH price move (not judges)
#   - Wide BB [0.3, 1.5) UP / (-1.5, -0.3) DOWN
#   - Requires abs(move) >= 0.04% (strong directional signal)
# Paper_replay 396h: 340t/63% WR/+$635 ($10 stake), 0.86/h volume.
# ALL 33 12h-periods POSITIVE. 24h: 32t/87.5% WR.
ETH5_DIRECT_TRIGGER=true
# 2026-06-06 v2: raised 0.04 -> 0.05. Robust sweep (96h split-half CV):
# 100% WR in both halves with move=0.05+start=160. PnL $52/day vs $42 at move=0.04.
ETH5_DIRECT_MOVE_THRESHOLD=0.05
# BB filter: active in both modes (Wide for direct, Symmetric for judge mode)
ETH5_BB_BAD_ZONE_FILTER=true
# Bad-hour filter: DISABLED 2026-04-20.
# Rationale: hour-of-day filter risks overfitting with small samples per hour.
# User prefers stable strategy over historically-optimal hours that may not repeat.
# Set empty to disable; set e.g. "3,9,15" to activate.
PAPER_BAD_HOURS_UTC=
ETH5_BAD_HOURS_UTC=
# ETH5 R2-direct sizing: DISABLED
# ETH5 72h live paper: stake>=$200 -> 11t/18%WR/-$1,361. Large bets TOXIC.
# Keep flat stake — don't amplify bets during regime shift.
ETH5_R2_SIZING=false
ETH5_SIZING_CAP_CEILING=1.5
# Max BTC move: DISABLED. Paper_replay showed removing = +$44 PnL (more trades).
# Min BTC move: DISABLED for BTC5. Paper_replay showed no improvement.
# Signal_cache_log analysis showed 0.03% profitable, but paper_replay timing differs.
PAPER_MIN_BTC_MOVE_PCT=0
PAPER_MAX_BTC_MOVE_PCT=0
# Momentum agreement: DISABLED. With ask=0.50 restored, momentum filter cuts good trades.
PAPER_REQUIRE_MOMENTUM_AGREE=false
# Judge Bias Correction: DISABLED. Live validation: breaks 24 wins, saves only 17 losses = net -7.
# Signal_cache_log analysis showed positive but live trades show opposite.
PAPER_JUDGE_BIAS_CORRECTION=false
PAPER_BIAS_LOOKBACK=4
PAPER_BIAS_THRESHOLD=0.80
# P_pos override: when price is at range extreme, override judge direction
# 1s chart data: p_pos>=0.8->UP WR 61% with 500ms delay (vs judges 52%)
PAPER_PPOS_OVERRIDE=true
PAPER_PPOS_THRESHOLD=0.80
# Prev window block: DISABLED. Was blocking 34%+ of trades (too aggressive).
# Mean reversion is handled by trend sizing (WITH=0.3x, AGAINST=2.5x) instead.
PAPER_PREV_WINDOW_BLOCK_PCT=0
# Lag Arb: enter when BTC moved 0.04%+ but CLOB hasn't repriced (ask <= 0.50)
# Backtest: +$2,166/20d with 300ms drift. Combined with judge: +$3,430/20d
LAG_ARB_BTC_THRESHOLD_PCT=0.04
LAG_ARB_MAX_ASK=0.50
# PROBABILITY_FIRST was blocking all entries: floor scales with ask price,
# penalties push model_prob below floor.  EV_FIRST checks (model_prob/ask - 1 - fee)
# which is a better profitability measure for lag arbitrage.
ENTRY_DECISION_MODE=EV_FIRST
# LIMIT_FAK: instant market order with limit price protection (1-3% taker fee).
# MAKER_FIRST was losing winning trades due to 8s delay + drift.
ENTRY_ORDER_MODE=LIMIT_FAK
# Rust fast order: sign+POST in ~200ms vs Python ~1100ms. Fallback to Python if fails.
USE_RUST_ORDER=true
LIMIT_ORDER_TIMEOUT_SECONDS=8.0
ORDER_POLL_INTERVAL_SECONDS=0.35
MAX_ENTRY_PRICE_DRIFT_ABS=0.080
MAX_ENTRY_PRICE_DRIFT_RATIO=0.150

# Live conservative guards
# Synced with PAPER_ENTRY_START_SEC=100
LIVE_ENTRY_START_SECONDS=100
LIVE_MIN_SUPPORT_RATIO=0.66
LIVE_REQUIRE_UNANIMOUS=false
LIVE_RECENT_MOVE_LOOKBACK_SEC=20
LIVE_MIN_RECENT_MOVE_PCT=0.004
LIVE_MAX_OPPOSITE_IMPLIED=0.78
LIVE_MIN_ENTRY_SIDE_IMPLIED=0.22
LIVE_DOWN_ABOVE_START_BLOCK_PCT=0.050
LIVE_DOWN_ABOVE_START_MOMENTUM_EXTRA=0.006
LIVE_DOWN_ABOVE_START_EV_PENALTY=0.020
LIVE_EARLY_EXIT_STOP_LOSS_ROI_PCT=-30

# ──────────────────────────────────────────────────────────────
# Paper entry guards — ALIGNED WITH BACKTEST (profit factor 1.44)
# ──────────────────────────────────────────────────────────────
PAPER_MIN_EXPECTED_ROI=0.070
PAPER_MIN_SUPPORT_RATIO=0.66
# conf: reverted to 0.55. 0.60 reduced trades too much without WR gain in paper_replay.
# 240h: ask=0.50 WR=57.8% +$5,612 (best). conf>=0.60 dropped to WR=56.9% +$5,206.
PAPER_MIN_CONFIDENCE=0.55
# BB extreme filter: only enter when price is at Bollinger Band extremes (|bb|>0.5)
# VWAP agree: price must be above/below VWAP matching bet direction
# paper_replay 480h: PF 1.23->1.36, PnL +$10,581->+$13,334, WR 51%->53%
PAPER_REQUIRE_BB_EXTREME=true
PAPER_BB_THRESHOLD=0.5
PAPER_REQUIRE_VWAP_AGREE=true
# Ask drift: skip when CLOB already priced in the move (ask rose >threshold from start)
# 2026-07-04 OOS validation: 0.05 -> 0.08 improved ALL months (Apr +$32, May +$43, Jun +$9).
PAPER_MAX_ASK_DRIFT=0.08
# BTC still moving: only enter when BTC moved in our direction over last 20s
# paper_replay 480h: 20s best (PnL $14,612 PF 1.56 vs 30s $13,531 PF 1.52)
PAPER_REQUIRE_BTC_STILL_MOVING=true
PAPER_BTC_STILL_LOOKBACK=20
# Dynamic sizing: DISABLED 2026-04-20 — stacks with trend_sizing/QS/R2 to create $500 bets.
# Current regime: $200+ stakes lose heavily (ETH5 11t/18%/-$1,361). Revert to flat $100.
PAPER_DYNAMIC_SIZING=false
# 2026-06-06: max_ask 0.52 -> 0.55. 96h sweep: max=0.55+bb=0.7 gives $48/day vs $44.
# 2026-07-04 OOS validation: start 80 -> 100 (all months better; also restores parity
# with LIVE_ENTRY_START_SECONDS=100 which was already 100 while paper was 80).
PAPER_ENTRY_START_SEC=100
PAPER_ENTRY_END_SEC=240
PAPER_MAX_ENTRY_PRICE=0.55
# Implied probability filters — relaxed to match Paper behavior.
# Live CLOB often shows thin orderbook (side_ask 0.15-0.35) early in
# windows while DB/Paper sees 0.40-0.50.  Old 0.38 threshold blocked
# nearly all live entries.  0.25/0.75 still filters truly degenerate
# orderbooks while letting normal trades through.
PAPER_MAX_OPPOSITE_IMPLIED=0.78
PAPER_MIN_ENTRY_SIDE_IMPLIED=0.22
# Tighter trend alignment (matched to backtest)
PAPER_TREND_ALIGN_MAX_OPPOSING_MOVE_PCT=0.004
# Contra gap — effectively disabled (0.50).
# Binary market: up_ask + down_ask ≈ 1.0, so contra gap is just market skew.
# EV gate already handles profitability check; contra gap was redundantly
# blocking most entries (typical gap 0.05-0.15 vs old threshold 0.030).
PAPER_MAX_CONTRA_GAP=0.50
PAPER_CONTRA_OVERRIDE_MIN_MODEL_PROB=0.66
PAPER_CONTRA_OVERRIDE_MIN_CONF=0.75
# DOWN-above-start (relaxed — reversals are profitable)
PAPER_DOWN_ABOVE_START_BLOCK_PCT=0.050
PAPER_DOWN_ABOVE_START_MOMENTUM_EXTRA=0.006
PAPER_DOWN_ABOVE_START_EV_PENALTY=0.020
# Stale relax (keep but constrained)
PAPER_STALE_RELAX_MAX=0.80
PAPER_STALE_RELAX_START_SEC=2400
PAPER_STALE_RELAX_FULL_SEC=9000
# ──────────────────────────────────────────────────────────────
# Exit policy — BINARY MARKET HOLD-TO-EXPIRY STRATEGY
# ──────────────────────────────────────────────────────────────
# Binary market: win=$1, lose=$0.  Mid-window prices are NOISE.
# Selling early = selling a winning ticket at a discount.
# Only exit when position is ALMOST CERTAINLY lost AND we can
# salvage meaningful capital (opposite >= 0.90, deep loss).
# ──────────────────────────────────────────────────────────────
# Disabled: hold-to-settlement better than early exit
PAPER_ENABLE_EARLY_EXIT=false
PAPER_EARLY_EXIT_MIN_ELAPSED_SEC=60
# Opposite prob surge — only when market is 90%+ against us
PAPER_EARLY_EXIT_OPPOSITE_ASK=0.90
PAPER_EARLY_EXIT_EARLY_OPPOSITE_ASK_EXTRA=0.02
PAPER_EARLY_EXIT_EARLY_OPPOSITE_LOSS_EXTRA_PCT=5
PAPER_EARLY_EXIT_OPPOSITE_CONFIRM_POLLS=5
# Stop loss — almost never (only at -85%, near total loss)
PAPER_EARLY_EXIT_STOP_LOSS_ROI_PCT=-95
PAPER_EARLY_EXIT_STOP_LOSS_LOW_CONF_RELAX_PCT=5
PAPER_EARLY_EXIT_EARLY_STOP_LOSS_EXTRA_PCT=5
# Hold almost to expiry
PAPER_EARLY_EXIT_MAX_HOLD_SEC=280
PAPER_EARLY_EXIT_TIMESTOP_MAX_ROI_PCT=-40
# ──────────────────────────────────────────────────────────────
# Trailing stop / Profit take / Break-even — DISABLED
# ──────────────────────────────────────────────────────────────
# Binary market ($1/$0) settles automatically in 5 minutes.
# Backtest evidence (103 trades):
#   - Trailing stop sold 18/29 winning positions early → cost -$1,269
#   - Profit take sold 42/47 winning positions early → cost -$1,125
#   - Only stop_loss/hard_adverse_flush have positive value (+$684)
# Boundary distance filter (0.030%) already handles divergence risk
# at entry, making exit-side divergence protection redundant.
# ──────────────────────────────────────────────────────────────
PAPER_EARLY_EXIT_TRAILING_STOP_MIN_PEAK_PCT=999
PAPER_EARLY_EXIT_TRAILING_STOP_DROP_PCT=999
PAPER_EARLY_EXIT_TRAILING_STOP_MIN_HOLD_SEC=9999
PAPER_EARLY_EXIT_PROFIT_TAKE_ROI_PCT=999
PAPER_EARLY_EXIT_PROFIT_TAKE_MIN_HOLD_SEC=9999
PAPER_EARLY_EXIT_TRAILING_FORCE_PEAK_PCT=999
PAPER_EARLY_EXIT_BREAK_EVEN_FORCE_PEAK_PCT=999
PAPER_EARLY_EXIT_PROFIT_TAKE_FORCE_ROI_PCT=999
# Only fire opposite surge late in the window
PAPER_EARLY_EXIT_OPPOSITE_LATE_ONLY_REMAINING_SEC=180
PAPER_EARLY_EXIT_OPPOSITE_SEVERE_ADVERSE_SIGMA_MULT=1.50
PAPER_EARLY_EXIT_OPPOSITE_SEVERE_ADVERSE_MIN_MOVE_PCT=0.080
# Remaining late-window gates (for future re-enable if needed)
PAPER_EARLY_EXIT_TRAILING_LATE_ONLY_REMAINING_SEC=180
PAPER_EARLY_EXIT_BREAK_EVEN_LATE_ONLY_REMAINING_SEC=120
PAPER_EARLY_EXIT_PROFIT_TAKE_LATE_ONLY_REMAINING_SEC=180
PAPER_TELEGRAM_NOTIFY_OPEN=true

# Coinflip weak-edge guard (blocks thin-margin entries near 50:50 price)
# Relaxed from 0.06→0.03: old threshold blocked all DOWN entries in balanced
# markets (ask 0.44-0.56). 72h backtest: 0.03 → +$881 PnL, PF 1.29→1.32
COINFLIP_GUARD_LO=0.44
COINFLIP_GUARD_HI=0.56
COINFLIP_MIN_PROB_MARGIN=0.03
COINFLIP_MIN_CONFIDENCE=0.45

# UP-only regime meta filter: blocks UP entries in noisy/whipsaw regimes.
# Lowered from 0.56→0.50: old threshold blocked almost all UP entries in
# sideways markets (score typically 0.48-0.55). 72h backtest: 0.50 → +$6,154
UP_REGIME_MIN_SCORE=0.50

# Critical params (dashboard_server.py fallbacks were wrong without these)
# Data quality — enough samples = confident entry
PAPER_MIN_TICK_SAMPLES=50
PAPER_MIN_ODDS_SAMPLES=16
# Momentum threshold — lowered from 0.006 to 0.004.
# Paper reads DB ticks, Live reads resampled WebSocket ticks — small
# data-source difference puts many entries right at the boundary.
# 0.004% still filters pure noise while reducing paper/live divergence.
PAPER_MIN_RECENT_MOVE_PCT=0.004
# Macro trend: backtest disables this entirely. 0.040% was blocking
# DOWN entries when BTC drifted +0.07% over 15min — but this IS the
# lag-arb opportunity. Raise to 0.10% to only block extreme trends.
PAPER_MACRO_TREND_BLOCK_PCT=0.10
PAPER_MIN_SECONDS_REMAINING=30
# Disable perf pause — old DRY_RUN trades recorded as losses poison the
# win rate, blocking live trading for 30min+ after every attempt.
PAPER_PERF_PAUSE_SEC=0
PAPER_MIN_RECENT_WIN_RATE=0.00
# ──────────────────────────────────────────────────────────────
# Divergence risk filter — Binance-Chainlink price gap protection
# Only enter when BTC has moved enough from window start that
# Chainlink divergence (~$15-25) cannot flip the settlement outcome.
# Relaxed from 0.040/0.050 → 0.015/0.020:
#   BTC横盤 regime (2026-03-19): 5-min moves average 0.02-0.025%.
#   Old 0.020/0.025 blocked nearly all entries in low-vol conditions.
#   At BTC $71k, 0.015% ≈ $10.7 margin — still safe vs typical
#   Chainlink offset of ~$15-25.
# ──────────────────────────────────────────────────────────────
# Sweep: 0.020 with JURY=2 gives best risk-adjusted result.
# JURY=2 already filters noise, so boundary can be relaxed.
# Raised 0.010->0.020: sweep showed btc_move>=0.02% filters coinflip entries
PAPER_MIN_BOUNDARY_DIST_PCT=0.020
PAPER_DOWN_MIN_BOUNDARY_DIST_PCT=0.030
# ──────────────────────────────────────────────────────────────
# DOWN-specific entry guards — Chainlink-high bias makes DOWN
# trades structurally harder.
# Extended from 160→180: jury often reaches DOWN consensus at 160-170s,
# other guards (boundary dist, confidence) already filter bad late entries.
# ──────────────────────────────────────────────────────────────
# Sweep: 200s gives DOWN more time to develop. With stronger entry gates
# (MIN_EDGE=0.10, JURY=2), late entries are already filtered for quality.
PAPER_DOWN_ENTRY_END_SEC=200
# Lowered to 0.15: Live CLOB best_ask shows thin-book prices (0.27-0.31)
# while actual fill happens at ~0.45-0.50 via FOK. The cheap-token guard
# was blocking valid trades. FOK protects against bad fills naturally.
PAPER_DOWN_MIN_ENTRY_PRICE=0.35

# Disable drawdown stop for paper trading (paper money — no real risk)
PAPER_MAX_DRAWDOWN_STOP_PCT=1.0
LIVE_EQUITY_SEED_CAPITAL=100.00
# Disable drawdown stop for live (same as paper=1.0)
# Was 0.20 default = $5 drawdown blocks all trades with $25 seed
LIVE_MAX_DRAWDOWN_STOP_PCT=1.0
# Live minimum bet size (prevents tiny bets where fees eat the edge)
LIVE_MIN_BET=1.00
# LIVE_SIZING_MODE is set at top of file (FIXED)
LIVE_DAILY_LOSS_LIMIT=100.00

# Dynamic profit-take: exit when bid reaches entry_price + offset
LIVE_PROFIT_TAKE_OFFSET=0.10
LIVE_PROFIT_TAKE_ENABLED=false

# Smart exit: re-evaluate jury every 10s mid-trade.
# If jury flips direction -> exit at bid. If NO_TRADE + ROI < -30% -> exit.
# 72h backtest: PF 1.22->2.08, avg loss -$187->-$22, drawdown -42%
# Rollback: set SMART_EXIT_ENABLED=false
# Disabled 2026-03-29: smart_exit jury flip handles this better.
# Was causing 5+ false exits/day at opp_ask 0.70-0.79. Rollback: set true
LIVE_MANIP_DEFENSE_ENABLED=false

# CLOB conviction exit: if CLOB strongly disagrees near expiry, exit.
# Data: opp_ask >= 0.65 at 20s predicts outcome 93% accurately.
# Disabled: hold-to-settlement better than early exit
CLOB_CONVICTION_EXIT_ENABLED=false
# Graduated in exit_policy.py: <=30s opp>=0.65, <=90s opp>=0.80, <=150s opp>=0.90
# These env vars are no longer used (graduated logic is hardcoded)

# Disabled: hold-to-settlement is more profitable than any exit strategy
# (exit cuts winners, bainary options settle automatically in 5 min)
SMART_EXIT_ENABLED=false
SMART_EXIT_INTERVAL_SEC=10
SMART_EXIT_MIN_ROI_PCT=-80
SMART_EXIT_MIN_HOLD_SEC=15

# ──────────────────────────────────────────────────────────────
# BTC 15min Market (uses BTC15_ prefix, falls back to PAPER_)
# ──────────────────────────────────────────────────────────────
# paper_replay 72h: start=240 ask=0.54 -> PF1.28 +$2,208 (all periods profitable)
BTC15_ENTRY_START_SEC=240
BTC15_ENTRY_END_SEC=720
BTC15_DOWN_ENTRY_END_SEC=600
BTC15_MAX_ENTRY_PRICE=0.54
BTC15_DOWN_MIN_ENTRY_PRICE=0.35
BTC15_MIN_SECONDS_REMAINING=60
BTC15_MAX_ODDS_SPREAD=0.20
BTC15_REQUIRE_BB_EXTREME=true
BTC15_BB_THRESHOLD=0.5
BTC15_REQUIRE_VWAP_AGREE=true
BTC15_MAX_ASK_DRIFT=0.08
BTC15_REQUIRE_BTC_STILL_MOVING=true
BTC15_BTC_STILL_LOOKBACK=20
BTC15_DYNAMIC_SIZING=true
BTC15_FIXED_STAKE=100.0
BTC15_SIZING_MODE=FIXED
BTC15_ENABLE_EARLY_EXIT=false

# ──────────────────────────────────────────────────────────────
# ETH 5min Market (uses ETH5_ prefix, falls back to PAPER_)
# Sweep winner (168h): VWAP+btcActive0.05+ask0.50+confSizing = 498t PF1.42 WR51.6% +$10,898
# 2026-06-06 v2: late entry start=160s (was 130s). Robust 96h sweep:
# start=160 + move=0.05 + bb=0.7-2.5 -> 100% WR (both halves) / $52/day.
ETH5_ENTRY_START_SEC=160
ETH5_ENTRY_END_SEC=240
ETH5_DOWN_ENTRY_END_SEC=200
# 2026-04-30 v2: param sweep found optimal config = max=0.55 + bb_min=0.7 + late entry.
# 240h replay: $+312 / 67.5% WR / 77 trades vs old setup $+92 (3.4x improvement).
# 480h replay: $+584 / $29/day vs old $+210 / $10/day (2.8x).
# big-loss buckets (<-$30): 0 vs 3 (much more stable).
ETH5_MAX_ENTRY_PRICE=0.55
ETH5_BB_MIN_ABS=0.7
ETH5_BB_MAX_ABS=2.5
ETH5_MIN_ENTRY_SCORE=2
ETH5_DOWN_MIN_ENTRY_PRICE=0.35
ETH5_MIN_SECONDS_REMAINING=30
ETH5_MAX_ODDS_SPREAD=0.20
ETH5_REQUIRE_BB_EXTREME=false
ETH5_BB_THRESHOLD=0.5
ETH5_REQUIRE_VWAP_AGREE=true
ETH5_MAX_ASK_DRIFT=999
ETH5_REQUIRE_BTC_STILL_MOVING=false
ETH5_BTC_STILL_LOOKBACK=20
ETH5_DYNAMIC_SIZING=true
ETH5_FIXED_STAKE=10.0
# Min bet: Polymarket requires ~$5 notional. Keep at $5 as safety floor.
# (With all sizing off + flat $10 stake, this shouldn't be hit.)
ETH5_MIN_BET=5
# Explicit disable of QS-inverse sizing for ETH5 (was unconditional bug)
ETH5_QS_INVERSE_SIZING=false
ETH5_SIZING_MODE=FIXED
ETH5_ENABLE_EARLY_EXIT=false
# Confidence filter: skip low-confidence jury decisions
# 240h backtest: conf>=0.60 -> 74.3% WR, conf>=0.55 -> 71.6% WR
# Blocks conf<0.60 losses (0.397, 0.533, 0.554, 0.568 all lost in live)
ETH5_MIN_CONFIDENCE=0.60
# Min move filter: skip coin-flip windows where price barely moved
# Live data: move<0.02% = WR 42% (24t), move>=0.02% = WR 62% (21t)
ETH5_MIN_MOVE_PCT=0.02
# BTC activity: skip dead markets where BTC 5min range < 0.05%
ETH5_BTC_ACTIVE_MIN_RANGE=0.05
ETH5_BTC_ACTIVE_LOOKBACK=300
# Confidence sizing: DISABLED 2026-04-20 — 2x boost on "all agree" trades losing heavily.
# Recent 72h ETH5: stake>=$200 -> 11t/18%WR/-$1,361. "Strong signal" = fake trend in current regime.
ETH5_CONF_SIZING_ENABLED=false
ETH5_CONF_SIZING_FULL_MULT=1.0
ETH5_BTC_LEADS_SEC=30
ETH5_BTC_LEADS_MIN_PCT=0.03
# Judge Bias Correction: DISABLED for ETH5. Saves 2 but breaks 2 = net zero.
# ETH5 market behaves differently from BTC5 (no mean reversion in direction bias).
ETH5_JUDGE_BIAS_CORRECTION=false
ETH5_BIAS_LOOKBACK=4
ETH5_BIAS_THRESHOLD=0.80
# P_pos override: DISABLED for ETH5. Breaks 6 wins vs saves 5 losses = net negative.
# ETH5 has different pattern: judges DOWN + high p_pos = DOWN is often correct.
ETH5_PPOS_OVERRIDE=false
ETH5_PPOS_THRESHOLD=0.80
ETH5_DAILY_LOSS_LIMIT=50.00
BTC15_DAILY_LOSS_LIMIT=100.00

# -----------------------------------------------------------------------------
# CLOB V2 (cutover 2026-04-28)
# -----------------------------------------------------------------------------
# Builder Code (bytes32 hex): replaces V1 HMAC builder auth.
# Get from polymarket.com/settings -> Builder Profile.
# Empty = no builder (zeros). Still works for own orders.
# Format: "0x" + 64 hex chars (or shorter, will be left-padded with zeros)
POLYMARKET_BUILDER_CODE=
